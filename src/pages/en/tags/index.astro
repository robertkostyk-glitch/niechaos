---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Tag from "@/components/Tag.astro";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { slugifyStr } from "@/utils/slugify";
import config from "@/config";

const posts = await getCollection("posts", ({ id }) => id.startsWith("en/"));
const tags = getUniqueTags(posts);
---

<Layout title={`Tags | ${config.site.title}`}>
  <Header activeNav="tags" />
  <main id="main-content" class="app-layout">
    <h1 class="text-2xl font-semibold sm:text-3xl">Tags</h1>
    <p class="mt-2 mb-6 italic">All the tags used in posts.</p>
    <ul>
      {tags.map((item: { tag: string; tagName: string }) => (
        <Tag tag={slugifyStr(item.tag)} tagName={item.tagName} size="lg" />
      ))}
    </ul>
  </main>
  <Footer />
</Layout>
