---
import { getCollection } from "astro:content";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

const { posts: postsConfig } = config;

const posts = await getCollection("posts", ({ id }) => id.startsWith("pl/"));
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    class="app-layout my-1"
  >
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        Niechaos
      </h1>
      <a
        target="_blank"
        href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}rss.xml`}
        class="inline-block"
        aria-label="RSS Feed"
        title="RSS Feed"
      >
        <IconRss
          width={20}
          height={20}
        />
        <span class="sr-only">RSS Feed</span>
      </a>

      <p class="my-2">
        Substrat, natura czasu i granice bytu. Deterministyczne modelowanie zjawisk fizycznych i biologicznych poza stochastyką.
      </p>
    </section>

    {
      featuredPosts.length > 0 && (
        <section id="featured" class="border-border border-b pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">Wyróżnione</h2>
          <ul>
            {featuredPosts.map(post => (
              <Card {...post} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">Ostatnie wpisy</h2>
          <ul>
            {recentPosts.map(
              (post, index) =>
                index < postsConfig.perIndex && (
                  <Card {...post} />
                )
            )}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href="/posts/">
        Wszystkie wpisy
        <IconArrowRight class="inline-block" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>
